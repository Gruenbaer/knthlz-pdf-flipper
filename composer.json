{
  "name": "knthlz/pdf-flipper",
  "description": "Native TYPO3 PDF reader with page turns, calm reading, local image previews and useful navigation.",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4 || ^14.3",
    "typo3/cms-frontend": "^13.4 || ^14.3",
    "typo3/cms-fluid-styled-content": "^13.4 || ^14.3"
  },
  "autoload": {
    "psr-4": {
      "Knthlz\\PdfFlipper\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "pdf_flipper"
    }
  }
}
